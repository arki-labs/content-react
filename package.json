{
  "name": "@arki/content-react",
  "version": "0.2.0",
  "description": "React components for content: MDX renderer, article, changelog and timeline views, code blocks, GitHub and tweet embeds, and a post search hook.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "react",
    "mdx",
    "content",
    "components",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.stories.*",
    "!src/**/tests/**",
    "!src/**/test/**",
    "!src/**/__tests__/**",
    "README.md",
    "llms.txt",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@arki/content": "0.2.0",
    "@arki/date": "0.5.0",
    "@arki/failure": "0.3.0",
    "@arki/icons": "0.2.0",
    "@arki/intl": "0.2.0",
    "@arki/math": "0.2.0",
    "@arki/schema": "0.3.0",
    "@arki/ui": "0.2.0",
    "@content-collections/mdx": "0.2.2",
    "nuqs": "2.10.1",
    "react-tweet": "^3.3.1",
    "rehype-react": "^8.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "use-intl": "4.14.9",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "publishConfig": {
    "access": "public"
  },
  "arki": {
    "bundlerOnly": [
      "."
    ]
  }
}
